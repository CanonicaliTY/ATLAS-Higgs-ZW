{
  "LEPTON": "mu",
  "BUILD_FRACTION": 1.0,
  "READ_FRACTION": 1.0,
  "FORCE_REBUILD": true,
  "ROOT_DIR": "../../tight-parquet-fsr",
  "PT_MIN": 10.0,
  "APPLY_MEDIUM_ID": true,
  "NOMINAL_ISO": {
    "ptcone_max": 9.0,
    "etcone_max": 6.0
  },
  "LOOSE_ISO": {
    "ptcone_max": 15.0,
    "etcone_max": 15.0
  },
  "REQUIRE_BOTH_ISO": true,
